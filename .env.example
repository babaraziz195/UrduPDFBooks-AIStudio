# ==============================================================================
# UrduPDFBooks - Environment Configuration Example
# ==============================================================================
# Duplicate this file to .env and fill in your credentials.
# NEVER commit your actual .env file or production secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SAFE CLIENT-SIDE VARIABLES (Visible to the browser, prefixed with VITE_)
# ------------------------------------------------------------------------------
# Obtain from your Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-jwt-key-here"

# ------------------------------------------------------------------------------
# 2. SECRET SERVER-SIDE VARIABLES (NEVER exposed to browser / client bundle)
# ------------------------------------------------------------------------------
# Port for the local Express dev/production server (default 3000)
PORT=3000

# Backblaze B2 Application Key ID (keyID)
# Generated from Backblaze B2 Console > Application Keys > Add a New Application Key
B2_KEY_ID="your_b2_key_id_here"

# Backblaze B2 Application Secret Key (applicationKey)
B2_APPLICATION_KEY="your_b2_application_key_here"

# The name of your private Backblaze B2 bucket
B2_BUCKET_NAME="book-library-pdfs-727"

# S3-compatible B2 endpoint (found in Bucket Details in Backblaze B2 console)
# Example: https://s3.us-east-005.backblazeb2.com or https://s3.us-west-004.backblazeb2.com
B2_ENDPOINT="https://s3.us-east-005.backblazeb2.com"

# Backblaze B2 AWS/S3 compatible region (e.g., us-east-005, us-west-004, eu-central-003)
B2_REGION="us-east-005"

# ------------------------------------------------------------------------------
# 3. GITHUB DEPLOYMENT TOKEN (Stored in AI Studio Secrets / .env only)
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (Classic or Fine-grained) with 'repo' scope
# Used by server-side deployment script to create & push to private repository
GITHUB_TOKEN="ghp_yourPersonalAccessTokenHere"

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE DEPLOYMENT CREDENTIALS (Stored in AI Studio Secrets / .env only)
# ------------------------------------------------------------------------------
# Cloudflare API Token created with "Cloudflare Pages (Edit)" permissions
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token_here"

# Cloudflare Account ID (Found in your Cloudflare dashboard URL or right-hand sidebar)
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id_here"

# Cloudflare Pages Project Name (Defaults to urdupdfbooks if not specified)
CLOUDFLARE_PROJECT_NAME="urdupdfbooks"

